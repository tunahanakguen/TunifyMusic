{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tunify Music",
  "version": "0.2.2",
  "identifier": "de.tunas.tunifymusic",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tunify Music",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$AUDIO/Tunify Music/**",
          "$APPDATA/voices/*/cover.*",
          "$APPDATA/voices/*/preview.mp3"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "TUNAS",
    "copyright": "GPL-3.0 · TUNAS",
    "shortDescription": "Tunify Music – Stimmen umwandeln, trainieren und Audio bereinigen, lokal",
    "licenseFile": "../../LICENSE",
    "resources": {
      "../../engine/tunify_engine/*.py": "engine/tunify_engine/",
      "../../engine/tunify_engine/assets/*": "engine/tunify_engine/assets/",
      "../../engine/requirements.lock.txt": "engine/requirements.lock.txt",
      "../../engine/setup.ps1": "engine/setup.ps1",
      "../../models/bundled-voices/": "voices/",
      "../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "German"
        ],
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4RDIwOUUxMzJGMURDOUIKUldTYjNQRXk0UW5TYUxrTTl5UnlhVnNSQ2M1S3phdHhPYi9SY3JUWGk1T05GSENPcWcrVFliSWYK",
      "endpoints": [
        "https://github.com/tunahanakguen/TunifyMusic/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
