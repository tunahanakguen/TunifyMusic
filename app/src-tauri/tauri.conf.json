{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tunify Music",
  "version": "0.1.0",
  "identifier": "de.tunas.tunifymusic",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tunify Music",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$AUDIO/Tunify Music/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "TUNAS",
    "copyright": "GPL-3.0 · TUNAS",
    "shortDescription": "Tunify Music – Stimmen umwandeln, trainieren und Musik erzeugen, lokal",
    "licenseFile": "../../LICENSE",
    "resources": {
      "../../engine/tunify_engine/*.py": "engine/tunify_engine/",
      "../../engine/acestep_worker.py": "engine/acestep_worker.py",
      "../../engine/acestep_download.py": "engine/acestep_download.py",
      "../../engine/requirements.lock.txt": "engine/requirements.lock.txt",
      "../../engine/setup.ps1": "engine/setup.ps1",
      "../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "German"
        ],
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
