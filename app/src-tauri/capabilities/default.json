{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$AUDIO/Tunify Music" }]
    },
    "dialog:allow-open",
    "dialog:allow-ask",
    "updater:default",
    "process:allow-restart"
  ]
}
